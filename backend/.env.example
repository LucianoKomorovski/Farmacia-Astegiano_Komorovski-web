# Plantilla de variables de entorno (SÍ va a git).
# El archivo real se llama `.env`, vive acá mismo (backend/) y NO se sube.
#
# Primera vez:
#   cp .env.example .env
#   # editá .env con tus valores
#
# Django carga: backend/.env  (ver FarmaciaAstegiano/settings.py → BASE_DIR)

SECRET_KEY=cambia-esto-por-una-clave-secreta
DEBUG=True

# Solo hace falta en producción (DEBUG=False), separados por coma:
# ALLOWED_HOSTS=midominio.com,www.midominio.com

# --- Tienda: Mercado Pago (credenciales de producción o sandbox) ---
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=
# MERCADOPAGO_WEBHOOK_SECRET=

# URL pública HTTPS (ngrok o dominio). Vacío en local simple → MP sin auto_return.
# SITE_URL=https://abc123.ngrok-free.app

# --- Tienda: transferencia bancaria (se muestra al cliente) ---
# TRANSFERENCIA_ALIAS=
# TRANSFERENCIA_CBU=

# TTL de reserva de stock en minutos (default 60)
# RESERVA_STOCK_TTL_MINUTOS=60

# Para probar webhook MP con ngrok (solo desarrollo):
# EXTRA_ALLOWED_HOSTS=abc123.ngrok-free.app

# --- Producción ---
# DEBUG=False
# ALLOWED_HOSTS=tudominio.com,www.tudominio.com
# CSRF_TRUSTED_ORIGINS=https://tudominio.com,https://www.tudominio.com

# --- Envío ---
# ENVIO_MONTO_FIJO=1500
# ENVIO_GRATIS_DESDE=15000

# --- WhatsApp tienda (solo dígitos, ej. 5493471543210) ---
# WHATSAPP_TIENDA=

# --- Email SMTP (notificaciones de pedido) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=tienda@tudominio.com
